# AI provider for notes/actions/Q&A/diagrams/email/research: claude | openai
AI_PROVIDER=openai

# Claude provider — requires Claude Code CLI login/auth
# ANTHROPIC_API_KEY=

# OpenAI provider — requires openai package and API key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Slack — for manual note/action exports
# Get one at: api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# Notion — for pushing action items into a database
# Get one at: notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Google Calendar — for creating calendar events
GOOGLE_CREDENTIALS_FILE=~/.config/google/meeting-credentials.json
GOOGLE_TOKEN_FILE=~/.config/google/meeting-token.json
GOOGLE_CALENDAR_TZ=America/New_York

# Whisper model size: tiny | base | small | medium | large-v3 (default: base)
# WHISPER_MODEL=base
